# ateapi.v1.ActorTemplate (protojson), Agent Substrate v1.0.0. Not a Kubernetes CRD.
# Create with: kubectl ate create actor-template -f <rendered>
# Placeholders: ${WORKLOAD_IMAGE} ${ANTHROPIC_API_KEY}
# The sandbox class (microvm) comes from the WorkerPool the workerSelector picks,
# and snapshots go to the install's SNAPSHOT_LOCATION.
metadata:
  atespace: egress-agent
  name: claude-microvm
workerSelector:
  matchLabels:
    workload: claude-egress
containers:
- name: claude
  image: ${WORKLOAD_IMAGE}
  env:
  - name: ACTOR_NAME
    value: "claude"
  - name: TASK
    value: "Tell me one short, surprising fact about microVMs. One sentence."
  - name: INTERVAL_SECONDS
    value: "20"
  - name: ANTHROPIC_API_KEY
    value: "${ANTHROPIC_API_KEY}"
resources:
  limits:
    cpuMillicores: 1000
    memoryBytes: 2147483648 # 2Gi
snapshotConfig:
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY

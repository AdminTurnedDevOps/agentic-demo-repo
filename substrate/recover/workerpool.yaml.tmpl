apiVersion: v1
kind: Namespace
metadata:
  name: ate-demo-recover
---
apiVersion: ate.dev/v1
kind: WorkerPool
metadata:
  name: recover
  namespace: ate-demo-recover
  labels:
    workload: ate-demo-recover
spec:
  replicas: 1
  workerImage: ${WORKER_IMAGE}
  sandboxClasses:
  - name: gvisor
  template:
    resources:
      requests:
        cpu: 250m
        memory: 1Gi
      limits:
        cpu: "1"
        memory: 1Gi

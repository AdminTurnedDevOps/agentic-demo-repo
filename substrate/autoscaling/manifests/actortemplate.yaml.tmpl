# ActorTemplate for the burst lab. This is NOT a Kubernetes object: it is the
# protojson form of substrate.ateapi.v1.ActorTemplate, created through the ate API.
#
# Rendered with envsubst (only the variable below is substituted):
#   envsubst '${COUNTER_IMAGE}' < manifests/actortemplate.yaml.tmpl \
#     | kubectl ate create actor-template -f -
#
# The atespace ate-lab-burst must exist first (kubectl ate create atespace ate-lab-burst).
#
# The workload is the upstream counter demo (demos/counter in the Substrate
# repo). Every reply prints the sandbox IP, an in-memory count, and a file
# count, so you can see which worker served a request and that state survived.
#
# There is no sandboxConfig in v1.0.0: the sandbox class comes from the
# WorkerPool the workerSelector picks (sandboxClasses: gvisor). Snapshots go to
# ate-api-server's --snapshot-location; a per-template storageLocation needs
# the PerTemplateSnapshotLocation preview gate, so this lab doesn't set one.

metadata:
  atespace: ate-lab-burst
  name: burst
workerSelector:
  matchLabels:
    workload: burst
containers:
- name: counter
  image: ${COUNTER_IMAGE}
  command:
  - /ko-app/counter
  # Polled on every wakeup (cold boot or restore). Resume returns only once
  # /readyz answers 200, so a routed request never hits a half-restored actor.
  wakeupProbe:
    httpGet:
      path: /readyz
      port: 80
snapshotConfig:
  # Process memory + rootfs + volumes: the in-memory count keeps climbing
  # across suspend/resume, which makes worker hand-offs easy to see.
  preferredFidelity: SNAPSHOT_FIDELITY_MEMORY
# Sizes the sandbox and is what the scheduler fits against a worker's capacity.
# v1.0.0 requires both cpu and memory. Memory is more than half of the worker's
# 1Gi limit (workerpool.yaml.tmpl), so each worker holds exactly one actor; CPU
# is half of the worker's 500m, so it never is the limit that bites.
resources:
  limits:
    cpuMillicores: 250
    memoryBytes: 805306368 # 768Mi

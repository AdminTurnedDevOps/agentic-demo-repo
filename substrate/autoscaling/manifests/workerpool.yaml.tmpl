# Namespace + WorkerPool for the burst lab.
#
# Rendered with envsubst (only ${ATEOM_IMAGE} is substituted):
#   envsubst '${ATEOM_IMAGE}' < manifests/workerpool.yaml.tmpl | kubectl apply -f -
#
# replicas: 2 is the starting size. Once the HPA in hpa.yaml is applied it owns
# spec.replicas through the WorkerPool /scale subresource. Re-applying this file
# after that resets the pool to 2 until the next HPA sync.

apiVersion: v1
kind: Namespace
metadata:
  name: ate-lab-burst
---
apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: burst
  namespace: ate-lab-burst
  labels:
    # The ActorTemplate's workerSelector matches this label.
    workload: burst
spec:
  replicas: 2
  workerImage: ${ATEOM_IMAGE}
  sandboxClasses:
  - name: gvisor
  # One actor per worker. A gVisor worker offers 1000 actor slots
  # (ateom --max-actors), so slots alone would let all six actors share two
  # workers and nothing would ever park. The worker also reports its ateom
  # container limits as capacity, and the scheduler only places an actor where
  # the template's resources.limits still fit. The template asks for 768Mi of
  # this 1Gi, so a second actor never fits. With limits only, requests default
  # to the same values: 10 workers request 5 vCPU and 10Gi.
  template:
    resources:
      limits:
        cpu: 500m
        memory: 1Gi

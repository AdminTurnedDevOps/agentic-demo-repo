      "updated": 1761400000000,
      "link": null,
      "locked": false,
      "text": "\u2460 reset() gives the episode a fresh interpreter in its actor   \u2192   the model writes code and calls run_python   \u2192   \u2461 \u2462 step() runs it in gVisor and returns stdout   \u2192\nsubmit_solution records the answer   \u2192   get_reward() resets and grades with hidden tests + a nonce   \u2192   GRPO updates the LoRA weights   \u2192   repeat, 8 rollouts at a time",
      "originalText": "\u2460 reset() gives the episode a fresh interpreter in its actor   \u2192   the model writes code and calls run_python   \u2192   \u2461 \u2462 step() runs it in gVisor and returns stdout   \u2192\nsubmit_solution records the answer   \u2192   get_reward() resets and grades with hidden tests + a nonce   \u2192   GRPO updates the LoRA weights   \u2192   repeat, 8 rollouts at a time",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": false

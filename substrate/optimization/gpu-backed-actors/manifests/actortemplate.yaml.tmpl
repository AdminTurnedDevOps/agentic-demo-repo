apiVersion: ate.dev/v1alpha1
kind: ActorTemplate
metadata:
  name: ${TEMPLATE}
  namespace: ${NAMESPACE}
spec:
  sandboxClass: gvisor
  workerSelector:
    matchLabels:
      workload: gpu-context-release
  containers:
  - name: gpu-context-release
    image: ${GPU_WORKLOAD_IMAGE}
    command:
    - /usr/local/bin/start.sh
    readyz:
      httpGet:
        path: /readyz
        port: 80
      timeoutSeconds: 300
    securityContext:
      capabilities:
        drop:
        - ALL
        add:
        - NET_BIND_SERVICE
  resources:
    limits:
      cpu: "1"
      memory: 2Gi
  snapshotsConfig:
    location: ${SNAPSHOT_LOCATION}
    onPause: Full
    onCommit: Full
